# patsakorn. mix shop — environment
# Leave DATABASE_URL empty to run on the built-in in-memory PostgreSQL (pg-mem).
# Example with Docker Compose: postgres://patsakorn:patsakorn@localhost:5432/patsakorn_mix_shop
DATABASE_URL=""
PGSSL="false"
PORT=3000
AUTH_SECRET=""
ADMIN_USERNAME=""
ADMIN_EMAIL="shop-admin@patsakorn.shop"
ADMIN_PASSWORD=""
NODE_ENV="development"
